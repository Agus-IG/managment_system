{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/managment_system/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/managment_system/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/managment_system",
  "projects": {
    "managment_system": {
      "type": "application",
      "root": "apps/managment_system",
      "entryFile": "main",
      "sourceRoot": "apps/managment_system/src",
      "compilerOptions": {
        "tsConfigPath": "apps/managment_system/tsconfig.app.json"
      }
    },
    "mailer-service": {
      "type": "application",
      "root": "apps/mailer-service",
      "entryFile": "main",
      "sourceRoot": "apps/mailer-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/mailer-service/tsconfig.app.json"
      }
    }
  }
}